{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rooPlayer",
  "version": "0.2.1",
  "identifier": "com.tzungli.rooplayer",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rooPlayer",
        "width": 1320,
        "height": 860,
        "minWidth": 840,
        "minHeight": 680,
        "decorations": false,
        "center": true,
        "transparent": false,
        "visible": false,
        "maximized": false,
        "backgroundColor": "#0e0f13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
